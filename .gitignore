# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Secrets: never commit API keys! ---
# The pattern, not just `.env`: a stray `.env.backup` or `.env.local` holds the same keys
# and is exactly the file someone commits by accident.
.env*
!.env.example

